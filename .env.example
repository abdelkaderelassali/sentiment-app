# Copier ce fichier en .env (ignoré par Git) et remplir les valeurs.
# Clés d'API de l'API /v1 : « cle:role » séparées par des virgules, rôles client ou admin, 16 caractères minimum.
# Générer une clé : python -c "import secrets; print(secrets.token_urlsafe(24))"
API_KEYS=remplacez-par-une-cle-client:client,remplacez-par-une-cle-admin:admin
# Origines web autorisées à appeler l'API depuis un navigateur (client web du TP 2)
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500
# Clients de l'API (Streamlit, client web, Spring Boot)
API_URL=http://127.0.0.1:8000
API_KEY=remplacez-par-une-cle-client
